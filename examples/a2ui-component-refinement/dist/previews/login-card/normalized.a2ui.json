{
  "version": "a2ui/v1",
  "metadata": {
    "name": "login-card",
    "description": "Minimal A2UI login card demonstrating bindings, refs, and component nesting"
  },
  "bindings": {
    "primary_color": {
      "kind": "literal",
      "value": "#3b82f6"
    },
    "submit_endpoint": {
      "kind": "expression",
      "expression": "config.api.url + '/login'"
    },
    "submit_label": {
      "kind": "literal",
      "value": "Sign in"
    },
    "themed_primary": {
      "kind": "ref",
      "ref": "primary_color"
    },
    "username_placeholder": {
      "kind": "literal",
      "value": "you@example.com"
    }
  },
  "root": {
    "id": "login-card",
    "type": "Container",
    "props": {
      "padding": "24px",
      "rounded": true
    },
    "bindings": {
      "accent": {
        "$ref": "themed_primary"
      }
    },
    "children": [
      {
        "id": "title",
        "type": "Heading",
        "props": {
          "level": 2,
          "text": "Welcome back"
        }
      },
      {
        "id": "username-field",
        "type": "TextField",
        "props": {
          "label": "Email"
        },
        "bindings": {
          "placeholder": {
            "$ref": "username_placeholder"
          }
        }
      },
      {
        "id": "password-field",
        "type": "TextField",
        "props": {
          "label": "Password",
          "type": "password"
        }
      },
      {
        "id": "submit-button",
        "type": "Button",
        "bindings": {
          "label": {
            "$ref": "submit_label"
          },
          "action": {
            "$ref": "submit_endpoint"
          }
        }
      }
    ]
  }
}