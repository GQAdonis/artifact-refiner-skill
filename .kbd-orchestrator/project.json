{
  "name": "artifact-refiner",
  "version": "1.2.0",
  "description": "PMPO-driven artifact refinement skill pack",
  "activePhase": null,
  "focus_project_path": "/Users/gqadonis/Projects/travisjames/skills/artifact-refiner",
  "worktreeRoot": "${HOME}/.claude/worktrees",
  "maxChildDepth": 4,
  "ux_profile": "advanced",
  "__ux_profile_note": "advanced → kbd-status is dense by default; beginner → kbd-status --explain is on by default (expands decision-log entries + next-and-why narrative). Verbosity only — never gates information.",
  "change_backend": "openspec",
  "openspec_path": "openspec/changes",
  "spec_path": "openspec/specs",
  "spec_paths": ["openspec/specs/*.md"],
  "openspec_available": true,
  "constraint_file": ".kbd-orchestrator/constraints.md",
  "build_health_command": "bash scripts/validate-marketplace.sh",
  "test_command": "bash scripts/validate-marketplace.sh",
  "lint_command": "for f in skills/*/SKILL.md agents/*.md; do head -5 \"$f\" | grep -q '^---' || { echo \"missing frontmatter: $f\"; exit 1; }; done",
  "dev_command": null,
  "preferred_planning_agent": "antigravity",
  "preferred_execution_agents": ["antigravity", "codex", "claude", "opencode"],
  "model_policy": {
    "default_endpoint": "host_harness",
    "phases": {
      "refiner-iterate": { "tier": "small", "prefer_endpoint": "openai_proxy", "prefer_model": "gpt-5.4-mini" },
      "refiner-evaluate": { "tier": "medium", "prefer_endpoint": "openai_proxy", "prefer_model": "gpt-5.3-codex" },
      "refiner-finalize": { "tier": "small", "prefer_endpoint": "openai_proxy", "prefer_model": "gpt-5.4-mini" }
    },
    "endpoints": {
      "host_harness": { "via": "host" },
      "openai_proxy": {
        "base_url": "http://localhost:8181/v1",
        "auth_mode": "chatgpt_oauth",
        "fallback_auth": "openai_api_key",
        "health_probe": "http://localhost:8181/health"
      }
    }
  },
  "agents_config": {
    "antigravity": {
      "entry": "SKILL.md slash commands",
      "strengths": ["multi-file features", "browser verification", "planning"]
    },
    "codex": {
      "entry": "OpenAI Codex CLI / app",
      "strengths": ["parallel isolated tasks via git worktrees"]
    },
    "claude": {
      "entry": "Claude Code CLI",
      "strengths": ["multi-file features", "planning", "skill orchestration"]
    },
    "opencode": {
      "entry": "OpenCode CLI",
      "strengths": ["quick targeted edits", "file patches"]
    }
  },
  "workspace": {
    "workspace_file": null,
    "folders": [
      {
        "path": "/Users/gqadonis/Projects/travisjames/skills/artifact-refiner",
        "role": "focus",
        "purpose": "Active project — all KBD operations target this directory",
        "write_access": true
      }
    ]
  }
}
